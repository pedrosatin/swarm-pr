def detect_harnesses():
    found = {}
    candidates = [
        ("claude-w", ["claude-w", "claude"]),
        ("cursor-agent", ["cursor-agent", "agent"]),
        ("codex", ["codex"]),
        ("opencode", ["opencode"]),
    ]
    for key, binaries in candidates:
        for b in binaries:
            path = shutil.which(b)
            if path:
                found[key] = path
                break
    return found

def get_real_claude_binary():
    c = shutil.which("claude-w") or shutil.which("claude")
    if not c:
        return None
    try:
        with open(c, "rb") as f:
            content = f.read(500)
            if b"#!/bin" in content:
                res = subprocess.run(["mise", "which", "claude"], capture_output=True, text=True)
                if res.returncode == 0 and res.stdout.strip():
                    return res.stdout.strip()
    except Exception:
        pass
    return c

def fetch_claude_models_dynamically():
    models = set(["sonnet", "opus", "fable", "haiku"])
    for conf_path in [os.path.expanduser("~/.claude/settings.json"), os.path.expanduser("~/.claude-w/config.json")]:
        if os.path.exists(conf_path):
            try:
                with open(conf_path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    for m in data.get("modelSettings", {}).keys():
                        models.add(m)
            except Exception:
                pass

    bin_path = get_real_claude_binary()
    if bin_path and os.path.exists(bin_path):
        try:
            res = subprocess.run(["strings", bin_path], capture_output=True, text=True)
            matches = re.findall(r'(claude-(?:sonnet|opus|haiku|fable)-[0-9a-zA-Z\.\-]+)', res.stdout)
            for m in matches:
                cleaned = re.sub(r'[^0-9a-zA-Z\.\-]+$', '', m)
                if not any(x in cleaned for x in ["example", "test", "schema", "@"]):
                    base = re.sub(r'-[0-9]{8}(-v[0-9]+)?$', '', cleaned)
                    base = re.sub(r'-v[0-9]+$', '', base)
                    if len(base) > 8:
                        models.add(base)
        except Exception:
            pass

    return sorted(list(models))

def fetch_cursor_models(binary):
    try:
        res = subprocess.run([binary, "--list-models"], capture_output=True, text=True, check=True)
        all_models = {}
        for line in res.stdout.splitlines():
            line = line.strip()
            if not line or line.startswith("Tip:"):
                continue
            parts = line.split(" - ", 1)
            if len(parts) == 2:
                all_models[parts[0].strip()] = parts[1].strip()
        return all_models
    except Exception as e:
        log("⚠️", f"Falha ao consultar modelos do cursor-agent: {e}")
        return {}

def fetch_opencode_models(binary):
    try:
        res = subprocess.run([binary, "models"], capture_output=True, text=True, check=True)
        models = []
        for line in res.stdout.splitlines():
            line = line.strip()
            if line and not line.startswith(("mise", "opencode@", "█", "▀")):
                models.append(line)
        return models
    except Exception as e:
        log("⚠️", f"Falha ao consultar modelos do opencode: {e}")
        return []

def fetch_codex_default_model():
    config_path = os.path.expanduser("~/.codex/config.toml")
    if os.path.exists(config_path):
        try:
            with open(config_path, "r", encoding="utf-8") as f:
                content = f.read()
                m = re.search(r'model\s*=\s*"([^"]+)"', content)
                if m:
                    return m.group(1)
        except Exception:
            pass
    return "gpt-5.6-luna"

