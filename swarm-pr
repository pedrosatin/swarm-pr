        "claude-opus-4-8",
        "gemini-3.8-flash",
        "gpt-5.6-terra",
        "gpt-5.6-sol",
        "gpt-5.6-luna",
        "kimi-k3",
        "auto"
    ]
    base_options = [b for b in popular_bases if any(b in m_id for m_id in all_models)]

    print(f"\n{Colors.BOLD}{Colors.CYAN}Selecione o Modelo para cursor-agent (detectados via CLI):{Colors.RESET}")
    for i, opt in enumerate(base_options):
        marker = f"{Colors.GREEN}[Padrão]{Colors.RESET}" if opt == default_model else ""
