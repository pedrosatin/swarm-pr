                if sub_choice.isdigit() and 1 <= int(sub_choice) <= len(matches):
                    return matches[int(sub_choice) - 1][0]
                continue
            elif val == custom_idx:
                custom_id = input("Digite o ID do modelo: ").strip()
                if custom_id:
                    return custom_id
                continue

        if choice in all_models or any(choice in m for m in all_models):
            return choice

        print(f"{Colors.RED}Opção inválida.{Colors.RESET}")

def resolve_cursor_model_id(binary, model_choice, effort):
    all_models = fetch_cursor_models(binary)
    if not all_models:
        return model_choice

    if model_choice in all_models:
        return model_choice

    candidate = f"{model_choice}-{effort}"
    if candidate in all_models:
        return candidate

    candidate_thinking = f"{model_choice}-thinking-{effort}"
    if candidate_thinking in all_models:
        return candidate_thinking

    return f"{model_choice}[effort={effort}]"

