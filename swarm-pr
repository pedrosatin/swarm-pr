def dispatch_coder(coder_cfg, task_description, branch_name):
    harness = coder_cfg["harness"]
    binary = coder_cfg["binary"]
    model = coder_cfg["model"]
    effort = coder_cfg["effort"]

    log("🚀", f"[{harness}] Implementando tarefa com modelo '{model}' (effort={effort})...")

    prompt = f"""
Você é o engenheiro responsável por implementar e ENTREGAR esta tarefa:
"{task_description}"

INSTRUÇÕES CRÍTICAS DE EXECUÇÃO:
1. Você DEVE implementar código real nos arquivos do projeto. NÃO apenas explique ou planeje.
2. Crie ou altere todos os arquivos necessários.
3. Se rodar servidores ou processos em background durante os testes, ENCERRE-OS antes de finalizar.
4. Ao concluir as alterações de código, você DEVE fazer:
   git add -A
   git commit -m "feat: {task_description[:50]}"
   git push -u origin {branch_name}
5. O PR só poderá ser aberto se houver commits reais criados e enviados para a branch remota.
"""
    is_claude = harness in ["claude-w", "claude"]
    if is_claude:
        cmd = [binary, "--dangerously-skip-permissions", "--verbose", "--output-format", "stream-json", "-p", prompt, "--model", model]
        if effort != "default":
            cmd += ["--effort", effort]
    elif harness in ["cursor-agent", "agent"]:
        cmd = [binary, "-p", "--force", "--model", model, prompt]
    elif harness == "codex":
        cmd = [binary, "exec", "--dangerously-bypass-approvals-and-sandbox", "-m", model]
        if effort != "default":
            cmd += ["-c", f"model_reasoning_effort={effort}"]
        cmd.append(prompt)
    elif harness == "opencode":
        cmd = [binary, "run", "--auto", "-m", model, prompt]
    else:
        cmd = [binary, prompt]

    retcode, _ = stream_agent_execution(cmd, harness, is_claude_json=is_claude)
    if retcode != 0:
        log("❌", f"{harness} encerrou com erro ({retcode}) na implementação.")
        sys.exit(retcode)

def dispatch_reviewer(reviewer_cfg, task_description, diff_content):
    harness = reviewer_cfg["harness"]
    binary = reviewer_cfg["binary"]
    model = reviewer_cfg["model"]
    effort = reviewer_cfg["effort"]

    log("🔍", f"[{harness}] Realizando code review com modelo '{model}' (effort={effort})...")

    max_diff_len = 50000
    if len(diff_content) > max_diff_len:
        diff_content = diff_content[:max_diff_len] + "\n\n[... Diff truncado devido ao limite de contexto ...]"

    prompt = f"""
Você é um Code Reviewer rigoroso. Analise este diff referente à tarefa:
"{task_description}"

DIFF:
```diff
{diff_content}
```

REGRAS:
1. Analise exclusivamente bugs reais, segurança, regressões, tipagem e performance.
2. Não comente sobre estilo puramente subjetivo se o código estiver limpo.
3. Seja conciso e direto.
4. Se o código estiver aprovado e pronto para merge, responda EXATAMENTE:
STATUS: APPROVED

5. Se houver problemas a corrigir, responda no formato:
STATUS: CHANGES_REQUESTED
- [Arquivo:Linha]: <problema específico e recomendação objetiva>
"""
    is_claude = harness in ["claude-w", "claude"]
    if harness in ["cursor-agent", "agent"]:
        cmd = [binary, "-p", "--mode", "ask", "--model", model, prompt]
    elif is_claude:
        cmd = [binary, "--dangerously-skip-permissions", "--verbose", "--output-format", "stream-json", "-p", prompt, "--model", model]
        if effort != "default":
            cmd += ["--effort", effort]
    elif harness == "codex":
        cmd = [binary, "exec", "-s", "read-only", "-m", model]
        if effort != "default":
            cmd += ["-c", f"model_reasoning_effort={effort}"]
        cmd.append(prompt)
    elif harness == "opencode":
        cmd = [binary, "run", "-m", model, prompt]
    else:
        cmd = [binary, prompt]

    _, output = stream_agent_execution(cmd, harness, is_claude_json=is_claude)
    return output

