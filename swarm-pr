# ==============================================================================
# Gestão Segura de Pull Request no Git e GitHub
# ==============================================================================

def ensure_pr_exists(task_description, branch_name, base_branch):
    """
    Garante que:
    1. Mudanças não commitadas sejam salvas.
    2. Existam commits entre base e head (evitando crash no GraphQL da gh CLI).
    3. A branch seja enviada para o GitHub (git push).
    4. O PR seja criado ou reutilizado.
    """
    # 1. Verifica se o agente deixou alterações soltas sem commit
    uncommitted = run_cmd(["git", "status", "--porcelain"], check=False)
    if uncommitted:
        log("⚠️", "Arquivos modificados detectados sem commit. Fazendo commit automático...")
        run_cmd(["git", "add", "-A"], check=False)
        run_cmd(["git", "commit", "-m", f"feat: {task_description[:50]}"], check=False)

    # 2. Verifica se há pelo menos 1 commit à frente da base
    commits_ahead = run_cmd(["git", "rev-list", "--count", f"{base_branch}..HEAD"], check=False)
    if not commits_ahead or commits_ahead.strip() == "0":
        commits_ahead = run_cmd(["git", "rev-list", "--count", f"origin/{base_branch}..HEAD"], check=False)

    if not commits_ahead or commits_ahead.strip() == "0":
        log("❌", f"Nenhum commit foi encontrado na branch '{branch_name}' em relação à '{base_branch}'.")
        log("⚠️", "O agente concluiu sem criar commits com alterações reais de código.")
        log("💡", "O GitHub exige pelo menos 1 commit de diferença para poder abrir um Pull Request.")
        return None

    # 3. Garante que a branch existe no remote (git push)
    log("⬆️", f"Sincronizando branch com o GitHub (git push -u origin {branch_name})...")
    push_res = subprocess.run(["git", "push", "-u", "origin", branch_name], capture_output=True, text=True)
    if push_res.returncode != 0:
        log("⚠️", f"Aviso no git push: {push_res.stderr.strip() or push_res.stdout.strip()}")

    # 4. Verifica se PR já existe
    existing = run_cmd(["gh", "pr", "view", "--json", "url", "-q", ".url"], check=False)
    if existing and existing.startswith("http"):
        log("📌", f"Pull Request já existente detectado: {existing}")
        return existing

    # 5. Criação do Pull Request
    log("📝", "Criando Pull Request via gh CLI...")
    title = f"feat: {task_description[:60]}"
    body = (
        f"## Task Description\n{task_description}\n\n"
        f"Automated PR created by `swarm-pr` loop."
    )
    cmd = [
        "gh", "pr", "create",
        "--title", title,
        "--body", body,
        "--head", branch_name,
        "--base", base_branch
    ]
    try:
        pr_url = run_cmd(cmd, check=True)
        log("🔗", f"Pull Request criado com sucesso: {pr_url}")
        return pr_url
    except Exception as e:
        log("❌", f"Falha ao criar PR via gh CLI: {e}")
        return None

