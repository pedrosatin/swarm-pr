def main():
    parser = argparse.ArgumentParser(
        description="Swarm-PR: Loop autônomo Coder <-> Reviewer com Live UI e descoberta dinâmica."
    )
    parser.add_argument("task", nargs="?", help="Descrição da tarefa a ser executada")
    parser.add_argument("--branch", help="Nome da branch git (padrão: swarm/<task-slug>)")
    parser.add_argument("--base", help="Branch base (padrão: detecta main/master)")
    parser.add_argument("--max-iter", type=int, default=3, help="Máximo de ciclos de review (padrão: 3)")
    parser.add_argument("--skip-initial", action="store_true", help="Pular implementação inicial e iniciar direto pelo review")
    parser.add_argument("-y", "--yes", action="store_true", help="Aceitar defaults automaticamente sem perguntas interativas")

    args = parser.parse_args()

    if not is_git_repo():
        log("❌", "Erro: O comando deve ser executado dentro de um repositório Git.")
        sys.exit(1)

    harnesses = detect_harnesses()
    if not harnesses:
        log("❌", "Nenhum CLI/harness compatível encontrado no sistema!")
        sys.exit(1)

    task = args.task
    if not task:
        try:
            task = input(f"{Colors.BOLD}Digite a descrição da tarefa: {Colors.RESET}").strip()
        except (KeyboardInterrupt, EOFError):
            print()
            sys.exit(1)
        if not task:
            log("❌", "A descrição da tarefa é obrigatória.")
            sys.exit(1)

    last_cfg = load_last_config()

    if not args.yes and sys.stdin.isatty():
        coder_cfg = configure_agent_role("coder", "claude-w", harnesses, last_cfg)
        reviewer_cfg = configure_agent_role("reviewer", "cursor-agent", harnesses, last_cfg)
        
        save_last_config({
            "coder_harness": coder_cfg["harness"],
            "coder_model": coder_cfg["model"],
            "coder_effort": coder_cfg["effort"],
            "reviewer_harness": reviewer_cfg["harness"],
            "reviewer_model": reviewer_cfg["model"],
            "reviewer_effort": reviewer_cfg["effort"]
        })
    else:
        def_c = "claude-w" if "claude-w" in harnesses else list(harnesses.keys())[0]
        def_r = "cursor-agent" if "cursor-agent" in harnesses else list(harnesses.keys())[0]
        
        c_h = last_cfg.get("coder_harness", def_c)
        coder_cfg = {
            "harness": c_h,
            "binary": harnesses[c_h],
            "model": last_cfg.get("coder_model", "sonnet" if c_h == "claude-w" else "cursor-grok-4.6"),
            "effort": last_cfg.get("coder_effort", "medium")
        }
        r_h = last_cfg.get("reviewer_harness", def_r)
        reviewer_cfg = {
            "harness": r_h,
            "binary": harnesses[r_h],
            "model": last_cfg.get("reviewer_model", "cursor-grok-4.6" if r_h == "cursor-agent" else "sonnet"),
            "effort": last_cfg.get("reviewer_effort", "medium")
        }

    base_branch = args.base or get_default_branch()
    branch_name = args.branch or f"swarm/{slugify(task)}"

    print(f"\n{Colors.BOLD}{Colors.GREEN}Resumo da Sessão Swarm-PR:{Colors.RESET}")
    print(f"  📌 Branch:   {branch_name} (base: {base_branch})")
    print(f"  🔨 Coder:    {coder_cfg['harness']} | Modelo: {coder_cfg['model']} | Effort: {coder_cfg['effort']}")
    print(f"  🧐 Reviewer: {reviewer_cfg['harness']} | Modelo: {reviewer_cfg['model']} | Effort: {reviewer_cfg['effort']}")
    print(f"  🔄 Max Iter: {args.max_iter}\n")

    if not args.skip_initial:
        log("🌿", f"Criando/alternando para branch '{branch_name}'...")
        run_cmd(["git", "checkout", "-B", branch_name], check=False)

        # 1. Coder implementa com streaming ao vivo
        dispatch_coder(coder_cfg, task, branch_name)

        # 2. Assegura commits, push e criação do PR
        pr_url = ensure_pr_exists(task, branch_name, base_branch)
        if not pr_url:
            log("🛑", "Execução interrompida: o Pull Request não pôde ser aberto.")
            log("👉", "Verifique se o Coder gerou commits reais no repositório antes de abrir a PR.")
            sys.exit(1)
    else:
        log("⏩", "Pulando implementação inicial. Usando estado atual do branch.")

    # 3. Loop de Revisão (Actor-Critic)
    for iteration in range(1, args.max_iter + 1):
        print("\n" + "=" * 50)
        log("🔄", f"Ciclo de Revisão {iteration}/{args.max_iter}")
        print("=" * 50)

        diff = get_filtered_diff(base_branch)
        if not diff:
            log("⚠️", "Nenhum diff encontrado em relação à branch base. Encerrando.")
            break

        review_result = dispatch_reviewer(reviewer_cfg, task, diff)

        print(f"\n------------------- Feedback do {reviewer_cfg['harness']} -------------------")
        print(review_result.strip())
        print("-" * 65 + "\n")

        if re.search(r"STATUS:\s*\[?APPROVED\]?", review_result, re.IGNORECASE):
            log("🎉", f"Código APROVADO pelo {reviewer_cfg['harness']}! PR validado e pronto para merge.")
            try:
                run_cmd([
                    "gh", "pr", "comment",
                    "--body", f"✅ Code review aprovado automaticamente pelo {reviewer_cfg['harness']} ({reviewer_cfg['model']}) no ciclo {iteration}."
                ], check=False)
            except Exception:
                pass
            return

        if iteration < args.max_iter:
            dispatch_refiner(coder_cfg, review_result, task, branch_name)
        else:
            log("⚠️", f"Limite de {args.max_iter} iterações atingido.")
            log("👉", "Os apontamentos restantes requerem validação manual humana.")

if __name__ == "__main__":
    main()
