#!/usr/bin/env python3
"""
Swarm-PR: Loop autônomo Actor-Critic com isolamento de contexto (estilo SwarmForge).
Obtém harnesses, modelos e reasoning efforts DINAMICAMENTE direto das CLIs instaladas.
Exibe logs e andamento em tempo real (Live UI) e valida estado do Git/PR com segurança.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys

# Desativa timeout de tarefas em background no Claude Code
os.environ["CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS"] = "0"

CONFIG_DIR = os.path.expanduser("~/.config/swarm-pr")
CONFIG_FILE = os.path.join(CONFIG_DIR, "last_config.json")

# Padrões a ignorar no diff para economizar contexto
DIFF_EXCLUDES = [
    ":!*package-lock.json",
    ":!*yarn.lock",
    ":!*pnpm-lock.yaml",
    ":!*Cargo.lock",
    ":!*poetry.lock",
    ":!*Gemfile.lock",
    ":!*composer.lock",
    ":!*.min.js",
    ":!*.min.css",
    ":!*.map",
]

class Colors:
    BOLD = "\033[1m"
    CYAN = "\033[36m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    RED = "\033[31m"
    DIM = "\033[2m"
    MAGENTA = "\033[35m"
    BLUE = "\033[34m"
    RESET = "\033[0m"

def log(icon, msg):
    print(f"{icon}  {msg}", flush=True)

def run_cmd(cmd_list, check=True, capture=True):
    try:
        res = subprocess.run(
            cmd_list,
            text=True,
            capture_output=capture,
            check=check
        )
        return res.stdout.strip() if capture else ""
    except subprocess.CalledProcessError as e:
        if capture:
            log("❌", f"Erro ao executar {' '.join(cmd_list)}:\n{e.stderr.strip() if e.stderr else e.stdout.strip()}")
        if check:
            raise e
        return ""

def is_git_repo():
    try:
        res = subprocess.run(
            ["git", "rev-parse", "--is-inside-work-tree"],
            capture_output=True,
            text=True
        )
        return res.returncode == 0 and res.stdout.strip() == "true"
    except FileNotFoundError:
        return False

def get_default_branch():
    try:
        ref = run_cmd(["git", "symbolic-ref", "refs/remotes/origin/HEAD"], check=False)
        if ref:
            return ref.split("/")[-1]
    except Exception:
        pass
    for candidate in ["main", "master"]:
        res = subprocess.run(["git", "rev-parse", "--verify", candidate], capture_output=True)
        if res.returncode == 0:
            return candidate
    return "main"

def slugify(text):
    slug = re.sub(r"[^\w\s-]", "", text.lower())
    slug = re.sub(r"[\s_]+", "-", slug).strip("-")
    return slug[:40] or "task"

def get_filtered_diff(base_branch):
    cmd = ["git", "diff", f"{base_branch}...HEAD", "--"] + DIFF_EXCLUDES
    try:
        return run_cmd(cmd, check=False)
    except Exception:
        return run_cmd(["git", "diff", f"origin/{base_branch}...HEAD", "--"] + DIFF_EXCLUDES, check=False)

def load_last_config():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {}

def save_last_config(cfg):
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
    except Exception:
        pass

# ==============================================================================
# Execução com Live Streaming e UI em Tempo Real
# ==============================================================================

def stream_agent_execution(cmd, harness_name, is_claude_json=False):
    """
    Executa o agente exibindo o progresso ao vivo na tela linha a linha.
    Para o Claude, decodifica o stream JSON para mostrar chamadas de ferramentas e pensamentos.
    Retorna o texto final acumulado do agente.
    """
    env = os.environ.copy()
    env["CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS"] = "0"

    print(f"{Colors.DIM}┌── Iniciando processo: {' '.join(cmd[:4])}...{Colors.RESET}", flush=True)

    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
        env=env
    )

    accumulated_text = []

    for line in proc.stdout:
        line_clean = line.strip()
        if not line_clean:
            continue

        if is_claude_json and line_clean.startswith("{") and line_clean.endswith("}"):
            try:
                data = json.loads(line_clean)
                event_type = data.get("type")

                if event_type == "assistant":
                    msg = data.get("message", {})
                    for c in msg.get("content", []):
                        ct = c.get("type")
                        if ct == "tool_use":
                            tool_name = c.get("name", "Tool")
                            inp = c.get("input", {})
                            if tool_name == "Bash":
                                cmd_run = inp.get("command", "")
                                print(f"{Colors.YELLOW}⚙️  [{harness_name}] ❯ {cmd_run[:120]}{Colors.RESET}", flush=True)
                            elif tool_name in ["Edit", "Write"]:
                                path = inp.get("file_path", "")
                                print(f"{Colors.BLUE}📝 [{harness_name}] Editando: {path}{Colors.RESET}", flush=True)
                            elif tool_name == "Read":
                                path = inp.get("file_path", "")
                                print(f"{Colors.DIM}📖 [{harness_name}] Lendo: {path}{Colors.RESET}", flush=True)
                            else:
                                print(f"{Colors.CYAN}🔧 [{harness_name}: {tool_name}] {str(inp)[:80]}{Colors.RESET}", flush=True)
                        elif ct == "text":
                            txt = c.get("text", "")
                            accumulated_text.append(txt)
                            print(f"{Colors.GREEN}💬 [{harness_name}]{Colors.RESET} {txt}", flush=True)

                elif event_type == "user":
                    msg = data.get("message", {})
                    for c in msg.get("content", []):
                        if c.get("type") == "tool_result":
                            res_str = str(c.get("content", ""))
                            first_line = res_str.splitlines()[0] if res_str else ""
                            if first_line:
                                print(f"{Colors.DIM}   └─ {first_line[:100]}{Colors.RESET}", flush=True)

                elif event_type == "system" and data.get("subtype") == "thinking_tokens":
                    # Indicador de raciocínio
                    print(f"{Colors.DIM}💭 [{harness_name}] Raciocinando...{Colors.RESET}", end="\r", flush=True)

                continue
            except Exception:
                pass

        # Linhas de texto comuns (ex: cursor-agent, codex ou fallback)
        accumulated_text.append(line)
        print(f"{Colors.DIM}[{harness_name}]{Colors.RESET} {line_clean}", flush=True)

    proc.wait()
    print(f"{Colors.DIM}└── Processo encerrado (código: {proc.returncode}){Colors.RESET}\n", flush=True)
    return proc.returncode, "".join(accumulated_text).strip()

