def select_claude_model_dynamically(default_model):
    all_models = fetch_claude_models_dynamically()
    if not all_models:
        all_models = ["sonnet", "opus", "fable", "claude-sonnet-5", "claude-opus-5"]

    priority = [
        "sonnet",
        "opus",
        "fable",
        "claude-sonnet-5",
        "claude-opus-5",
        "claude-opus-4-8",
        "claude-fable-5-1",
        "claude-haiku-4-5"
    ]
    base_options = [p for p in priority if p in all_models]
    for m in all_models:
        if m not in base_options:
            base_options.append(m)

    featured = base_options[:8]

    print(f"\n{Colors.BOLD}{Colors.CYAN}Selecione o Modelo para Claude Code (extraídos dinamicamente da CLI):{Colors.RESET}")
    for i, opt in enumerate(featured):
        marker = f"{Colors.GREEN}[Padrão]{Colors.RESET}" if opt == default_model else ""
        print(f"  {Colors.BOLD}[{i+1}]{Colors.RESET} {opt} {marker}")

    search_idx = len(featured) + 1
    custom_idx = len(featured) + 2
    print(f"  {Colors.BOLD}[{search_idx}]{Colors.RESET} 🔍 Buscar / Filtrar todos os {len(all_models)} modelos da CLI do Claude")
    print(f"  {Colors.BOLD}[{custom_idx}]{Colors.RESET} Digitar qualquer nome/alias de modelo manualmente")

    while True:
        try:
            choice = input(f"Escolha [padrão: {default_model}]: ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nCancelado.")
            sys.exit(1)

        if not choice:
            return default_model

        if choice.isdigit():
            val = int(choice)
            if 1 <= val <= len(featured):
                return featured[val - 1]
            elif val == search_idx:
                term = input("Termo de busca (ex: opus, sonnet, fable, 4-8): ").strip().lower()
                matches = [m for m in all_models if term in m.lower()]
                if not matches:
                    print(f"{Colors.YELLOW}Nenhum modelo encontrado com '{term}'.{Colors.RESET}")
                    continue
                print(f"\n{Colors.BOLD}Modelos encontrados ({len(matches)}):{Colors.RESET}")
                for j, m in enumerate(matches[:20]):
                    print(f"  {Colors.BOLD}[{j+1}]{Colors.RESET} {m}")
                sub_choice = input(f"Escolha o número (1-{min(len(matches), 20)}): ").strip()
                if sub_choice.isdigit() and 1 <= int(sub_choice) <= len(matches):
                    return matches[int(sub_choice) - 1]
                continue
            elif val == custom_idx:
                custom_id = input("Digite o nome ou ID do modelo: ").strip()
                if custom_id:
                    return custom_id
                continue

        if choice in all_models:
            return choice

        print(f"{Colors.RED}Opção inválida.{Colors.RESET}")

