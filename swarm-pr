    search_idx = len(base_options) + 1
    custom_idx = len(base_options) + 2
    print(f"  {Colors.BOLD}[{search_idx}]{Colors.RESET} 🔍 Buscar / Filtrar todos os {len(all_models)} modelos da CLI")
    print(f"  {Colors.BOLD}[{custom_idx}]{Colors.RESET} Digitar qualquer ID de modelo manualmente")

    while True:
        try:
            choice = input(f"Escolha [padrão: {default_model}]: ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nCancelado.")
            sys.exit(1)

        if not choice:
            return default_model

        if choice.isdigit():
            val = int(choice)
            if 1 <= val <= len(base_options):
                return base_options[val - 1]
            elif val == search_idx:
                term = input("Termo de busca (ex: grok, sonnet, gemini, opus): ").strip().lower()
                matches = [(m_id, desc) for m_id, desc in all_models.items() if term in m_id.lower() or term in desc.lower()]
                if not matches:
                    print(f"{Colors.YELLOW}Nenhum modelo encontrado com '{term}'.{Colors.RESET}")
                    continue
                print(f"\n{Colors.BOLD}Modelos encontrados ({len(matches)}):{Colors.RESET}")
