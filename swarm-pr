def configure_agent_role(role_name, default_harness, harnesses, last_cfg):
    print(f"\n{Colors.BOLD}{'='*15} CONFIGURAÇÃO: {role_name.upper()} {'='*15}{Colors.RESET}")

    saved_harness = last_cfg.get(f"{role_name}_harness", default_harness)
    if saved_harness not in harnesses:
        saved_harness = list(harnesses.keys())[0]

    harness_list = list(harnesses.keys())
    print(f"\n{Colors.BOLD}{Colors.CYAN}Selecione o Harness/CLI para {role_name}:{Colors.RESET}")
    for i, h in enumerate(harness_list):
        marker = f"{Colors.GREEN}[Padrão]{Colors.RESET}" if h == saved_harness else ""
        print(f"  {Colors.BOLD}[{i+1}]{Colors.RESET} {h} {marker}")

    while True:
        try:
            choice = input(f"Escolha [padrão: {saved_harness}]: ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nCancelado.")
            sys.exit(1)

        if not choice:
            chosen_harness = saved_harness
            break
        if choice.isdigit() and 1 <= int(choice) <= len(harness_list):
            chosen_harness = harness_list[int(choice) - 1]
            break
        if choice in harness_list:
            chosen_harness = choice
            break
        print(f"{Colors.RED}Opção inválida.{Colors.RESET}")

    binary = harnesses[chosen_harness]
    saved_model = last_cfg.get(f"{role_name}_model", "")
    chosen_effort = "medium"

    if chosen_harness in ["claude-w", "claude"]:
        def_model = saved_model or "sonnet"
        chosen_model = select_claude_model_dynamically(def_model)

        efforts = ["low", "medium", "high", "max"]
        saved_eff = last_cfg.get(f"{role_name}_effort", "medium")
        print(f"\n{Colors.BOLD}{Colors.CYAN}Nível de Esforço (Claude --effort):{Colors.RESET}")
        for i, eff in enumerate(efforts):
            marker = f"{Colors.GREEN}[Padrão]{Colors.RESET}" if eff == saved_eff else ""
            print(f"  {Colors.BOLD}[{i+1}]{Colors.RESET} {eff} {marker}")
        eff_choice = input(f"Escolha [padrão: {saved_eff}]: ").strip()
        if eff_choice.isdigit() and 1 <= int(eff_choice) <= len(efforts):
            chosen_effort = efforts[int(eff_choice) - 1]
        elif eff_choice in efforts:
            chosen_effort = eff_choice
        else:
            chosen_effort = saved_eff

    elif chosen_harness in ["cursor-agent", "agent"]:
        def_model = saved_model or "cursor-grok-4.6"
        chosen_model_base = select_cursor_model_dynamically(binary, def_model)

        if any(chosen_model_base.endswith(f"-{eff}") for eff in ["low", "medium", "high", "xhigh", "max"]):
            chosen_model = chosen_model_base
            chosen_effort = chosen_model_base.split("-")[-1]
        else:
            print(f"\n{Colors.BOLD}{Colors.CYAN}Nível de Esforço (Reasoning / Thinking Effort):{Colors.RESET}")
            efforts = ["low", "medium", "high", "xhigh", "max"]
            saved_eff = last_cfg.get(f"{role_name}_effort", "medium")
            for i, eff in enumerate(efforts):
                marker = f"{Colors.GREEN}[Padrão]{Colors.RESET}" if eff == saved_eff else ""
                print(f"  {Colors.BOLD}[{i+1}]{Colors.RESET} {eff} {marker}")
            eff_choice = input(f"Escolha [padrão: {saved_eff}]: ").strip()
            if eff_choice.isdigit() and 1 <= int(eff_choice) <= len(efforts):
                chosen_effort = efforts[int(eff_choice) - 1]
            elif eff_choice in efforts:
                chosen_effort = eff_choice
            else:
                chosen_effort = saved_eff
            chosen_model = resolve_cursor_model_id(binary, chosen_model_base, chosen_effort)

    elif chosen_harness == "opencode":
        def_model = saved_model or "opencode-go/grok-4.6"
        chosen_model = select_opencode_model_dynamically(binary, def_model)
        chosen_effort = "default"

    elif chosen_harness == "codex":
        active_model = fetch_codex_default_model()
        codex_models = [active_model, "o3", "o4-mini", "gpt-5.5"]
        def_model = saved_model or active_model
        print(f"\n{Colors.BOLD}{Colors.CYAN}Selecione o Modelo para Codex (configurado: {active_model}):{Colors.RESET}")
        for i, m in enumerate(codex_models):
            marker = f"{Colors.GREEN}[Padrão]{Colors.RESET}" if m == def_model else ""
            print(f"  {Colors.BOLD}[{i+1}]{Colors.RESET} {m} {marker}")
        c_choice = input(f"Escolha [padrão: {def_model}]: ").strip()
        chosen_model = codex_models[int(c_choice)-1] if c_choice.isdigit() and 1 <= int(c_choice) <= len(codex_models) else (c_choice or def_model)
        chosen_effort = "medium"

    return {
        "harness": chosen_harness,
        "binary": binary,
        "model": chosen_model,
        "effort": chosen_effort
    }

